#!/usr/bin/env bash
# Seleciona um Python com os bindings gráficos do sistema, sem abrir janela.
set -e
SERIFA_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SERIFA_SYSTEM_ONLY=0
if [ "${1:-}" = "--system" ]; then
    SERIFA_SYSTEM_ONLY=1
    shift
fi

if [ -n "${SERIFA_PYTHON:-}" ]; then
    SERIFA_CANDIDATES=("$SERIFA_PYTHON")
else
    SERIFA_CANDIDATES=()
    if [ "$SERIFA_SYSTEM_ONLY" = 0 ]; then
        SERIFA_CANDIDATES+=("$SERIFA_ROOT/.venv/bin/python")
    fi
    SERIFA_CANDIDATES+=(/usr/bin/python3 python3)
fi

SERIFA_ERRORS=""
for SERIFA_CANDIDATE in "${SERIFA_CANDIDATES[@]}"; do
    if ! command -v "$SERIFA_CANDIDATE" >/dev/null 2>&1; then
        continue
    fi
    if SERIFA_ERROR="$("$SERIFA_CANDIDATE" "$SERIFA_ROOT/bin/runtime.py" 2>&1)"; then
        if [ "${1:-}" = "--check" ]; then
            "$SERIFA_CANDIDATE" -c 'import sys; print("Python e bibliotecas gráficas OK:", sys.executable)'
            if ! command -v latexmk >/dev/null; then
                echo "Aviso: instale latexmk e TeX para compilar documentos." >&2
            fi
            exit 0
        fi
        exec "$SERIFA_CANDIDATE" "$@"
    fi
    SERIFA_ERRORS+="$SERIFA_ERROR"$'\n'
done

printf '%s\n' "Não foi encontrado um Python compatível com as bibliotecas do Serifa." >&2
if [ -n "$SERIFA_ERRORS" ]; then
    printf '%s' "$SERIFA_ERRORS" >&2
fi
printf '%s\n' "Instale as dependências do sistema descritas no README." \
    "Para escolher outro interpretador: SERIFA_PYTHON=/caminho/python3 bin/python --check" >&2
exit 1

# Aponta o git para os hooks versionados. Opcional, e reversível com
#   git config --unset core.hooksPath
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1
git config core.hooksPath .githooks
echo "hooks ligados: .githooks (pre-push roda ruff + suíte)"

#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-only
# Copyright (C) 2026 Vinícius Bispo e colaboradores
# PyGObject comes from the system; the venv needs --system-site-packages.
set -e
cd "$(dirname "${BASH_SOURCE[0]}")/.."
if ! command -v uv >/dev/null; then
    echo "Install uv to set up the environment: https://docs.astral.sh/uv/getting-started/installation/" >&2
    exit 1
fi
SERIFA_SYSTEM_PYTHON="$(bin/python --system -c 'import sys; print(sys.executable)')"
uv venv --allow-existing --python "$SERIFA_SYSTEM_PYTHON" --system-site-packages .venv
uv sync --locked --no-install-project --no-python-downloads
bin/python --check
echo "Ready. bin/serifa, bin/test and bin/lint use the .venv."

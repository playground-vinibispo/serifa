#!/usr/bin/bash
# Bisect do modo vim. Rode em ordem e pare na primeira que vazar:
#   bin/diagnostico-vim minimo   -> só a receita oficial do GtkSourceView
#   bin/diagnostico-vim popup    -> a receita + o controlador que o popup tinha
#   bin/diagnostico-vim editor   -> a classe Editor da Serifa
#   bin/diagnostico-vim janela   -> a Serifa inteira
exec /usr/bin/python3.12 "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/diagnostico_vim.py" "$@"

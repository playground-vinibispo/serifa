SERIFA_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Passing the root as an argument preserves paths with spaces and quotes.
exec "$SERIFA_ROOT/bin/python" -c '
import sys
sys.path.insert(0, sys.argv.pop(1))
from serifa.main import main
sys.exit(main())
' "$SERIFA_ROOT" "$@"

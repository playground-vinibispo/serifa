SERIFA_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
case "${1:-minimal}" in
    minimal|popup|editor|window) ;;
    --help|-h)
        echo 'Usage: bin/debug-vim [minimal|popup|editor|window]'
        exit 0 ;;
    *)
        echo 'Unknown scenario. Use minimal, popup, editor or window.' >&2
        exit 2 ;;
esac
exec "$SERIFA_ROOT/bin/python" "$SERIFA_ROOT/debug_vim.py" "$@"

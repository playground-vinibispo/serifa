#!/usr/bin/bash
# Suíte da Serifa.
#   bin/testes                       tudo
#   bin/testes -v                    verboso
#   bin/testes testes.test_blocos    um módulo
#   bin/testes --cobertura           com relatório de cobertura
#   bin/testes --na-tela             na sessão gráfica atual, sem isolar
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1

# As janelas dos testes abrem num mutter headless próprio, com barramento D-Bus
# próprio: nada aparece na tela nem rouba o foco de quem está trabalhando.
# Tirar o WAYLAND_DISPLAY não bastaria: sem ele a libwayland cai no wayland-0,
# que é a sessão do usuário. Sem mutter (a CI usa xvfb-run), roda direto.
#
# ADW_DISABLE_PORTAL: no barramento novo, o xdg-desktop-portal sobe sob demanda
# e trava esperando o serviço de segredos, e o Adw.init() espera o portal até
# o timeout do D-Bus -- 25 s de 55 s de suíte. De brinde, o tema fica sempre o
# padrão, sem o modo escuro da sessão vazar para os testes.
if [ "$1" = "--na-tela" ]; then
    shift
elif [ -z "$SERIFA_ISOLADO" ] && command -v mutter >/dev/null; then
    SOQUETE="serifa-testes-$$"
    exec dbus-run-session -- mutter --headless --no-x11 \
        --virtual-monitor 1280x800 --wayland-display="$SOQUETE" -- \
        env -u DISPLAY WAYLAND_DISPLAY="$SOQUETE" SERIFA_ISOLADO=1 \
        ADW_DISABLE_PORTAL=1 GTK_A11Y=none \
        "$0" "$@" 2> >(grep -vE '^(libmutter|\(mutter|mutter|Gdk-Message|A connection to the bus)' >&2)
fi

# O venv do uv, quando existe; senão o Python do sistema, que é onde o gi vive.
PY=".venv/bin/python"
[ -x "$PY" ] || PY="/usr/bin/python3.12"

if [ "$1" = "--cobertura" ]; then
    shift
    "$PY" -m coverage run -m unittest discover -s testes -t . "$@" || exit 1
    "$PY" -m coverage report -m
    exit 0
fi

if [ $# -gt 0 ] && [[ "$1" != -* ]]; then
    exec "$PY" -m unittest "$@"
fi
exec "$PY" -m unittest discover -s testes -t . "$@"

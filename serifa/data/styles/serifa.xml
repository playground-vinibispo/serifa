<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="serifa" name="Serifa" version="1.0">
 <author>Serifa</author>
 <description>Ink on a cool white writing surface</description>
 <style name="text" foreground="#24344b" background="#ffffff"/>
 <style name="selection" background="#d9e5f8" foreground="#24344b"/>
 <style name="search-match" background="#ffe5a3" foreground="#24344b"/>
 <style name="cursor" foreground="#305fa8"/>
 <style name="def:comment" foreground="#7c899b" italic="true"/>
 <style name="def:keyword" foreground="#42679d"/>
 <style name="def:statement" foreground="#42679d"/>
 <style name="def:type" foreground="#42679d"/>
 <style name="def:function" foreground="#42679d"/>
 <style name="def:string" foreground="#547d75"/>
 <style name="def:constant" foreground="#6e6090"/>
 <style name="def:special-char" foreground="#6e6090"/>
 <style name="def:note" foreground="#42679d" background="#eef2f8"/>
 <style name="bracket-match" foreground="#305fa8" background="#d9e5f8"/>
</style-scheme>
